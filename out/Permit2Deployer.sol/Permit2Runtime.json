7:18482:134;;;;-1:-1:-1;;;2077:18482:134;;;;;;;;;;;;;;-1:-1:-1;;;;;2077:18482:134;;;;-1:-1:-1;;;;;2077:18482:134;;;;;;;;;;;;;;;;;;;-1:-1:-1;;;;;2077:18482:134;;;;-1:-1:-1;;2077:18482:134;;;;-1:-1:-1;;;;;2077:18482:134;;;;-1:-1:-1;;2077:18482:134;;;;;;;;;;;;;;;;;;;;;;;;;;;;;-1:-1:-1;;;;;2077:18482:134;;;;-1:-1:-1;;;;;2077:18482:134;;;;;;;;;-1:-1:-1;;2077:18482:134;;;;;;;;;-1:-1:-1;;;;;2077:18482:134;;;;;;;;;;;;;;;;;;;;;;;;-1:-1:-1;;;;;2077:18482:134;;;;;;;;;;;;;;-1:-1:-1;;;;;2077:18482:134;;;;;;;;;-1:-1:-1;;;;;2077:18482:134;;;;-1:-1:-1;;2077:18482:134;;;;-1:-1:-1;;;2077:18482:134;;;;-1:-1:-1;;;;;2077:18482:134;;;;-1:-1:-1;;;;2077:18482:134;;;;-1:-1:-1;;2077:18482:134;;;;;;;;;;;;;;;;;;;;;;;;-1:-1:-1;;;2077:18482:134;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;20482:69;2077:18482;;:::i;:::-;;;;;;;;;;;;;;;","linkReferences":{}},"deployedBytecode":{"object":"0x5f80fdfea2646970667358221220cdad913f7865efcfc25c02f5f917367caddb1fb04dddf19137731b038929ebff64736f6c634300081a0033","sourceMap":"2077:18482:134:-:0;;","linkReferences":{}},"methodIdentifiers":{},"rawMetadata":"{\"compiler\":{\"version\":\"0.8.26+commit.8a97fa7a\"},\"language\":\"Solidity\",\"output\":{\"abi\":[{\"inputs\":[],\"stateMutability\":\"nonpayable\",\"type\":\"constructor\"}],\"devdoc\":{\"kind\":\"dev\",\"methods\":{},\"title\":\"Permit2Runtime\",\"version\":1},\"userdoc\":{\"kind\":\"user\",\"methods\":{},\"notice\":\"DEV-ONLY. Deploys the canonical Uniswap Permit2 RUNTIME bytecode at a fresh CREATE         address as a REAL transaction, so it persists on an anvil node reached through         `forge script --broadcast` (unlike `vm.etch`, which only mutates forge's in-memory         fork and is never sent to the node).         Permit2's own source pins `pragma solidity 0.8.17` (exact) and needs via-IR, so it         cannot be compiled into this 0.8.26 project. Instead the constructor RETURNS the         canonical runtime bytecode, making this contract's code identical to a real Permit2.         Permit2's EIP-712 domain separator is either a value CACHED at construction (chain id         + address baked into the runtime) or, when `block.chainid` differs from that cached         chain id, RECOMPUTED live from `block.chainid` + `address(this)`. The vendored test         helper's blob has chain id 31337 baked in \\u2014 the SAME id anvil uses \\u2014 so at THIS         contract's fresh CREATE address it returned the STALE cached separator (computed for         the canonical Permit2 address, not this one), and every Permit2 signature failed with         `InvalidSigner`. FIX: the cached chain-id immutable in the blob below is patched from         31337 (0x7a69) to 1, so on anvil (31337 != 1) the separator is ALWAYS recomputed from         this contract's real address \\u2014 matching exactly what the frontend signs. Proven:         DOMAIN_SEPARATOR() == keccak256(abi.encode(typeHash, keccak256(\\\"Permit2\\\"), 31337,         address(this))).         NEVER deploy on a real network: Robinhood already has the canonical Permit2. Only         DeployLocalV1 uses this. The bytecode below is the vendored permit2 test-helper         runtime (permit2/test/utils/DeployPermit2.sol) with that ONE chain-id constant         patched (0x7a69 -> 0x01). Do NOT \\\"restore\\\" it to the verbatim blob or the bug returns.\",\"version\":1}},\"settings\":{\"compilationTarget\":{\"src/dev/Permit2Deployer.sol\":\"Permit2Runtime\"},\"evmVersion\":\"cancun\",\"libraries\":{},\"metadata\":{\"bytecodeHash\":\"ipfs\"},\"optimizer\":{\"enabled\":true,\"runs\":200},\"remappings\":[\":@openzeppelin/contracts/=node_modules/@openzeppelin/contracts/\",\":@uniswap/v4-core/=node_modules/@uniswap/v4-core/\",\":@uniswap/v4-periphery/=node_modules/@uniswap/v4-periphery/\",\":forge-std/=lib/forge-std/src/\",\":permit2/=node_modules/@uniswap/v4-periphery/lib/permit2/\",\":solmate/=node_modules/@uniswap/v4-core/lib/solmate/\"],\"viaIR\":true},\"sources\":{\"src/dev/Permit2Deployer.sol\":{\"keccak256\":\"0xf06af6b6e23990b67be3a5851525107bde5cc71c5332461a429290e45dc4c205\",\"license\":\"MIT\",\"urls\":[\"bzz-raw://58299650d5c634e67371828110e7bb4d611586b7b6e12010f0654674627cd757\",\"dweb:/ipfs/QmPwphhcfjX43CryPKYsBiTDyTSZRdaAw8tqpDAfTqw7Sc\"]}},\"version\":1}","metadata":{"compiler":{"version":"0.8.26+commit.8a97fa7a"},"language":"Solidity","output":{"abi":[{"inputs":[],"stateMutability":"nonpayable","type":"constructor"}],"devdoc":{"kind":"dev","methods":{},"version":1},"userdoc":{"kind":"user","methods":{},"version":1}},"settings":{"remappings":["@openzeppelin/contracts/=node_modules/@openzeppelin/contracts/","@uniswap/v4-core/=node_modules/@uniswap/v4-core/","@uniswap/v4-periphery/=node_modules/@uniswap/v4-periphery/","forge-std/=lib/forge-std/src/","permit2/=node_modules/@uniswap/v4-periphery/lib/permit2/","solmate/=node_modules/@uniswap/v4-core/lib/solmate/"],"optimizer":{"enabled":true,"runs":200},"metadata":{"bytecodeHash":"ipfs"},"compilationTarget":{"src/dev/Permit2Deployer.sol":"Permit2Runtime"},"evmVersion":"cancun","libraries":{},"viaIR":true},"sources":{"src/dev/Permit2Deployer.sol":{"keccak256":"0xf06af6b6e23990b67be3a5851525107bde5cc71c5332461a429290e45dc4c205","urls":["bzz-raw://58299650d5c634e67371828110e7bb4d611586b7b6e12010f0654674627cd757","dweb:/ipfs/QmPwphhcfjX43CryPKYsBiTDyTSZRdaAw8tqpDAfTqw7Sc"],"license":"MIT"}},"version":1},"id":134}